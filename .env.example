# Langfuse Cloud Japan; do not commit real keys.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://jp.cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development
LANGFUSE_TIMEOUT_SECONDS=5

# LLM budget controls are applied before new Batch submission.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
LLM_DAILY_BUDGET_USD=
LLM_BUDGET_WARNING_RATIOS=0.70,0.90,1.00

# Slack Incoming Webhook for terminal OpenAI Batch notifications.
SLACK_WEBHOOK_URL=
OPENAI_BATCH_POLL_INTERVAL_SECONDS=60
OPENAI_BATCH_MONITOR_TIMEOUT_SECONDS=90000

# Error-Alert (https://github.com/Halofty/Error-Alert) ingest endpoint. Set by
# the DAG's on_failure_callback whenever any task (any stage, any mapped
# date) finally fails after retries. ALERT_SERVER_URL is the ingest_server's
# reachable base URL (e.g. http://<host>:8001, no trailing /ingest); leave
# either value empty to skip reporting (logs a warning, never fails the DAG).
ALERT_SERVER_URL=
ALERT_SERVER_TOKEN=

# Local-only MinIO development credentials. Replace them outside local development.
MINIO_ROOT_USER=news_pipeline
MINIO_ROOT_PASSWORD=news_pipeline_minio_dev
MINIO_API_PORT=9002
MINIO_ENDPOINT=http://localhost:9002
# Airflow container에서 host의 MinIO로 접근할 때 사용합니다.
MINIO_AIRFLOW_ENDPOINT=http://host.docker.internal:9002
MINIO_CONSOLE_URL=http://localhost:9101
MINIO_RAW_BUCKET=news-raw
MINIO_PROCESSED_BUCKET=news-processed
MINIO_LLM_BUCKET=news-llm
MINIO_REPORTS_BUCKET=news-reports
MINIO_CHECKPOINT_BUCKET=news-checkpoints
PIPELINE_STORAGE_BACKEND=minio
PIPELINE_DATA_ROOT=data

# Kafka topics used by the bounded Airflow batch path.
KAFKA_RAW_TOPIC=raw-text
KAFKA_DLQ_TOPIC=raw-text-dlq

# Local service credentials. Change them outside local development.
AIRFLOW_USERNAME=admin
AIRFLOW_PASSWORD=news_pipeline_airflow_dev

POSTGRES_DB=news_pipeline
POSTGRES_USER=news_pipeline
POSTGRES_PASSWORD=news_pipeline_dev
POSTGRES_DSN=postgresql://news_pipeline:news_pipeline_dev@localhost:5432/news_pipeline
POSTGRES_AIRFLOW_DSN=postgresql://news_pipeline:news_pipeline_dev@host.docker.internal:5432/news_pipeline
